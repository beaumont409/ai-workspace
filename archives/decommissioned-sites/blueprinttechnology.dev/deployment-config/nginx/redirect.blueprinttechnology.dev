server {
    server_name redirect.blueprinttechnology.dev;
    root /var/www/redirect;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/redirect.blueprinttechnology.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/redirect.blueprinttechnology.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = redirect.blueprinttechnology.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name redirect.blueprinttechnology.dev;
    return 404; # managed by Certbot


}