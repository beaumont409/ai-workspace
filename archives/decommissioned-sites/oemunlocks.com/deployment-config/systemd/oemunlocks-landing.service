[Unit]
Description=OEMUnlocks Landing Flask Application
After=network.target

[Service]
User=root
WorkingDirectory=/opt/oemunlocks-new
Environment="PATH=/opt/oemunlocks-new/venv/bin"
ExecStart=/opt/oemunlocks-new/venv/bin/python /opt/oemunlocks-new/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
